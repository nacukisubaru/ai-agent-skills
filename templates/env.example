# Доступы стенда. Скопируйте в <project>/.github/.env.local и заполните.
# Файл в git не попадает. Имена переменных стандартные для скиллов:
#   ui-testing-playwright, pdf-instructions, manual-testing.
#
# Логин Bitrix — технический (часто вида rad_<hash>_<email>), но мост авторизации
# принимает и email: он сам найдёт LOGIN по EMAIL. Достаточно заполнить одно из двух.

RAD_BASE_URL=http://localhost:8080

RAD_ADMIN_LOGIN=
RAD_ADMIN_EMAIL=
RAD_ADMIN_PASSWORD=
