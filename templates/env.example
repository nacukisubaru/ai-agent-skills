# Доступы стенда. Скопируйте в <project>/.github/skills/.env.local и заполните.
# Файл в git не попадает (см. .gitignore рядом).
#
# Имена переменных стандартные; за что каждая отвечает — project-features.md.
# Логин Bitrix часто технический (prefix_<hash>_<email>), но способ входа из
# скилла bitrix-login принимает и email: он сам найдёт LOGIN по EMAIL.

SITE_BASE_URL=http://localhost:8080

SITE_ADMIN_LOGIN=
SITE_ADMIN_EMAIL=
SITE_ADMIN_PASSWORD=

# Токен Figma для скилла figma-layout (личный, только локально).
FIGMA_TOKEN=
